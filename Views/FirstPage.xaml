<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.FirstPage"
             Title="FirstPage">
    <!--this page will show User Data from a List-->
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="User Data" 
               FontSize="24" 
               HorizontalOptions="Center" 
               VerticalOptions="Start" 
               Margin="0,20,0,10"/>
            <VerticalStackLayout x:Name="DataLayout"
                             Spacing="10"
                             Padding="10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>