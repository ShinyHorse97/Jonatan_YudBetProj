<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.LoginPage"
             Title="Login"
             Background="Black">

    <Grid>
        <!-- subtle diagonal stripe using two layered rectangles -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070707" Offset="0" />
                <GradientStop Color="#0f0f0f" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                <Border Style="{StaticResource CardFrameStyle}" WidthRequest="420">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Log In" Style="{StaticResource HeaderLabelStyle}" />
                        <Label Text="Sign in to access the pit" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" />

                        <Entry Text="{Binding EmailEntry}" Placeholder="Email" Keyboard="Email" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding EmailErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasEmailError}" />

                        <Entry Text="{Binding PasswordEntry}" Placeholder="Password" IsPassword="True" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding PasswordErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasPasswordError}" />

                        <Label Text="{Binding LoginErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasLoginError}" />
                        <Button Text="LOGIN" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoginCommand}" />

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="Don't have an account?" TextColor="{StaticResource TextLight}" FontSize="12" VerticalOptions="Center" />
                            <Button Text="Register" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" FontAttributes="Bold" Command="{Binding RegisterCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
