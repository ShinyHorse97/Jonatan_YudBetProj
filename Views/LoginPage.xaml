<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.LoginPage"
             Title="LoginPage">
    <!--Login Page with email and password field and -->
    <VerticalStackLayout
        Spacing="25"
        Padding="30"
        VerticalOptions="Center">
        <Label
            Text="Login to Jonatan_YudBetProj!"
            FontSize="32"
            HorizontalOptions="Center" />
        <Entry
            x:Name="EmailEntry"
            Placeholder="Email"
            Keyboard="Email" />
        <Label
            x:Name="EmailErrorLabel"
            TextColor="Red"
            IsVisible="False" />
        <Entry
            x:Name="PasswordEntry"
            Placeholder="Password"
            IsPassword="True" />
        <Label
            x:Name="PasswordErrorLabel"
            TextColor="Red"
            IsVisible="False" />
        <Button
            Text="Login"
            FontSize="18"
            Clicked="OnLoginButtonClicked" />
    </VerticalStackLayout>
</ContentPage>