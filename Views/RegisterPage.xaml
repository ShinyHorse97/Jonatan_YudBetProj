<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.RegisterPage"
             Title="Register"
             Background="Black">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070707" Offset="0" />
                <GradientStop Color="#0f0f0f" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Spacing="18" Padding="24" HorizontalOptions="Center" VerticalOptions="Center">
                <Border Style="{StaticResource CardFrameStyle}" WidthRequest="460">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Sign Up" Style="{StaticResource HeaderLabelStyle}" />
                        <Label Text="Join the grid — create your account" TextColor="{StaticResource TextLight}" HorizontalOptions="Center" />

                        <Entry Text="{Binding UsernameEntry}" Placeholder="Username" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding UsernameErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasUsernameError}" />

                        <Entry Text="{Binding EmailEntry}" Placeholder="Email" Keyboard="Email" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding EmailErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasEmailError}" />

                        <Entry Text="{Binding PasswordEntry}" Placeholder="Password" IsPassword="True" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding PasswordErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasPasswordError}" />

                        <Entry Text="{Binding ConfirmPasswordEntry}" Placeholder="Confirm Password" IsPassword="True" Style="{StaticResource EntryStyle}" />
                        <Label Text="{Binding ConfirmPasswordErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasConfirmPasswordError}" />

                        <Label Text="{Binding RegisterErrorMessage}" Style="{StaticResource ErrorLabelStyle}" IsVisible="{Binding HasRegisterError}" />

                        <Button Text="REGISTER" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RegisterCommand}" />


                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="Already have an account?" TextColor="{StaticResource TextLight}" FontSize="12" VerticalOptions="Center" />
                            <Button Text="Login" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" FontAttributes="Bold" Command="{Binding LoginCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
