<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.RegisterPage"
             Title="RegisterPage">
    <!-- register page with fields for email, password, and confirm password -->
    <ScrollView>
        <VerticalStackLayout
        Spacing="25"
        Padding="30"
        VerticalOptions="Center">
            <Label
            Text="Register for Jonatan_YudBetProj!"
            FontSize="32"
            HorizontalOptions="Center" />
            <Entry
            x:Name="UsernameEntry"
            Placeholder="Username" />
            <Label x:Name="UsernameErrorLabel"
               TextColor="Red"
               IsVisible="False"/>
            <Entry
            x:Name="EmailEntry"
            Placeholder="Email"
            Keyboard="Email" />
            <Label
            x:Name="EmailErrorLabel"
            TextColor="Red"
            IsVisible="False" />
            <Entry
            x:Name="PasswordEntry"
            Placeholder="Password"
            IsPassword="True" />
            <Label
            x:Name="PasswordErrorLabel"
            TextColor="Red"
            IsVisible="False" />
            <Label
            x:Name="ConfirmPasswordErrorLabel"
            TextColor="Red"
            IsVisible="False" />
            <Entry
            x:Name="ConfirmPasswordEntry"
            Placeholder="Confirm Password"
            IsPassword="True" />
            <Button
            Text="Register"
            FontSize="18"
            Clicked="OnRegisterButtonClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>