<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.SplashScreen"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0B0B0B">
    <Grid Padding="24"
          RowDefinitions="Auto,*"
          RowSpacing="20">
        <Image Source="purplesectorlogo.png"
               HeightRequest="84"
               WidthRequest="150"
               Aspect="AspectFit"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               AutomationProperties.Name="Purple Sector logo" />

        <GraphicsView x:Name="SectorChart"
                      x:FieldModifier="private"
                      Grid.Row="1"
                      HeightRequest="120"
                      HorizontalOptions="Center"
                      WidthRequest="300"
                      VerticalOptions="Center"
                      AutomationProperties.Name="Three sector race analysis animation" />
    </Grid>
</ContentPage>