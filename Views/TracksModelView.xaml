<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Jonatan_YudBetProj.Views.TracksModelView"
             Title="TracksModelView">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding raceTracks}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout>
                        <Label Text="{Binding Name}" />
                        <Label Text="{Binding Location}" />
                        <Label Text="{Binding Length, StringFormat='Length: {0} m'}" />
                        <Label Text="{Binding Turns, StringFormat='Turns: {0}'}" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>